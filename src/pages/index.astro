---
import Layout from "../layouts/Layout_main.astro";
---

<Layout>
	<body id="body">
		<div class="MAINPAGE">
			<div class="firma_GROUP">
				<img class="firma Asize" src="/01A_firma.png" />
			</div>

			<div class="meanim_GROUP">
				<a id="link_cv" class="Asize hover" href="/cv"> </a>
				<img class="meanim Asize" src="/02A_01meanim.png" />
				<img class="meanim Asize" src="/02A_02meanim.png" />
				<img class="meanim Asize" src="/02A_03meanim.png" />
				<img class="meanim Asize" src="/02A_02meanim.png" />
			</div>

			<div class="sparksanim_GROUP">
				<img class="sparkanim Asize" src="/02A_01sparks.png" />
				<img class="sparkanim Asize" src="/02A_02sparks.png" />
			</div>

			<div class="props_GROUP">
				<a id="link_prop01" class="Asize hover" href="/animation"></a>
				<a id="link_prop02" class="Asize hover" href="/bg"></a>
				<a id="link_prop03" class="Asize hover" href="/storyboard"></a>
				<a id="link_prop04" class="Asize hover" href="/layout"></a>
				<a id="link_prop05" class="Asize hover" href="/visdev"></a>
				<a id="link_prop06" class="Asize hover" href="/3D"></a>
				<img class="prop01 prop Asize" src="/03A_01props.png" />
				<img class="prop02 prop Asize" src="/03A_02props.png" />
				<img class="prop03 prop Asize" src="/03A_03props.png" />
				<img class="prop04 prop Asize" src="/03A_04props.png" />
				<img class="prop05 prop Asize" src="/03A_05props.png" />
				<img class="prop06 prop Asize" src="/03A_06props.png" />
				<img class="prop07 prop Asize" src="/03A_07props.png" />
				<h1 id="title_prop01" class="Asize prop prop_text">
					Animation
				</h1>
				<h1 id="title_prop02" class="Asize prop prop_text">BG</h1>
				<h1 id="title_prop03" class="Asize prop prop_text">Story</h1>
				<h1 id="title_prop04" class="Asize prop prop_text">Layout</h1>
				<h1 id="title_prop05" class="Asize prop prop_text">Visdev</h1>
				<h1 id="title_prop06" class="Asize prop prop_text">3D</h1>
			</div>

			<div class="social_icons_GROUP">
				<a id="link_email" class="Asize hover" href="/contact">
					<img
						class="email social_icon Asize"
						src="/05A_01email.png"
					/></a
				>

				<a
					id="link_in"
					class="Asize hover"
					target="_blank"
					href="https://www.linkedin.com/in/moiraframos/"
				>
					<img class="in social_icon Asize" src="/05A_02in.png" /></a
				>
				<a
					id="link_insta"
					class="Asize hover"
					target="_blank"
					href="https://www.instagram.com/moira_framos/"
					><img
						class="insta social_icon Asize"
						src="/05A_03insta.png"
					/></a
				>
				<a
					id="link_git"
					class="Asize hover"
					target="_blank"
					href="https://github.com/moiraframos"
					><img
						class="git social_icon Asize"
						src="/05A_04git.png"
					/></a
				>
			</div>

			<div class="BG_GROUP">
				<img class="bg Asize" src="/06A_BG.png" />
			</div>
		</div>
	</body>
</Layout>
