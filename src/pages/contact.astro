---
import Layout from "../layouts/Layout_page.astro";
---

<Layout>
    <body id="body">
        <section id="portfolio_page">
            <div class="email_page_group">
                <h2 class="page_section_text">Contact me!</h2>

                <button class="copy_button" ;>
                    <img class="copy_icon" src="/01C_02copy_icon.png" />
                </button>
            </div>

            <script>
                const button = document.querySelector(".copy_button");
                const emailText = document.getElementById("email");

                button?.addEventListener("click", () => {
                    const text = emailText?.textContent || "";
                    navigator.clipboard
                        .writeText(text)
                        .then(() => {
                            alert("Email copiado!"); // O puedes cambiar el texto del botón
                        })
                        .catch((err) => {
                            console.error("Error al copiar:", err);
                        });
                });
            </script>
        </section>

        <script>
            function copyText() {
                /* Copy text into clipboard */
                navigator.clipboard.writeText("f.r.moira@gmail.com");
            }
        </script>
    </body>
</Layout>
